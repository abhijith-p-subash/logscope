{
  "name": "logscope-cli",
  "version": "0.1.1",
  "description": "Offline log analysis for AWS CloudWatch exports — reassembles fragmented events and reconstructs concurrent request traces.",
  "type": "module",
  "license": "MIT",
  "author": "Abhijith P Subash <abhijith.p.subash@gmail.com>",
  "keywords": [
    "cloudwatch",
    "logs",
    "log-viewer",
    "log-analysis",
    "aws",
    "lambda",
    "trace",
    "offline",
    "cli",
    "qa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhijith-p-subash/logscope.git"
  },
  "homepage": "https://github.com/abhijith-p-subash/logscope#readme",
  "bugs": {
    "url": "https://github.com/abhijith-p-subash/logscope/issues"
  },
  "bin": {
    "logscope": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:cli": "tsup",
    "build": "npm run build:web && npm run build:cli",
    "prepublishOnly": "npm run build",
    "test:e2e": "playwright test",
    "gen:fixtures": "node --experimental-strip-types scripts/gen-large-fixture.ts"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "commander": "12.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.62.1",
    "@tanstack/react-virtual": "3.14.10",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
